---
import { hero } from '../../content/data/copy';
---

<section class="hero" id="top" data-section="hero">
  <div class="hero-media">
    <video
      class="hero-video"
      id="hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-hidden="true"
    >
      <source src="/video/hero-source.mp4" type="video/mp4" />
    </video>
    <div class="hero-vignette"></div>
  </div>

  <div class="container hero-content">
    <p class="kicker" data-reveal>{hero.kicker}</p>
    <h1 class="hero-model" id="hero-model" aria-label={hero.model}>
      {hero.model.split('').map((ch) => <span class="ch">{ch}</span>)}
    </h1>
  </div>

  <a href="#advantage" class="scroll-cue" aria-label="Прокрутить к следующему разделу">
    <span class="scroll-cue-line"></span>
    <span class="scroll-cue-label">Скролл</span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 560px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: #000;
    padding-block: 0 var(--space-lg);
  }
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }
  .hero-video.is-playing { opacity: 1; }
  .hero-vignette {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(10,11,13,0.95) 0%, rgba(10,11,13,0.35) 38%, rgba(10,11,13,0.15) 60%, rgba(10,11,13,0.55) 100%),
      radial-gradient(ellipse at center 60%, transparent 35%, rgba(0,0,0,0.55) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .hero-model {
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 22vw, 14rem);
    line-height: 0.85;
    color: var(--c-light);
    text-shadow: 0 0 60px rgba(79, 182, 255, 0.25);
    margin-block: 0.2em 0.1em;
  }
  .hero-model .ch { display: inline-block; }

  .hero-content .kicker {
    font-size: clamp(0.85rem, 1.6vw, 1.15rem);
  }

  .scroll-cue {
    position: absolute;
    right: var(--content-pad);
    bottom: var(--space-md);
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--c-text-dim);
  }
  .scroll-cue-label {
    font-family: var(--font-label);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
  }
  .scroll-cue-line {
    width: 1px;
    height: 48px;
    background: var(--c-text-faint);
    position: relative;
    overflow: hidden;
  }
  .scroll-cue-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--c-accent);
    transform: translateY(-100%);
    animation: cue-drop 1.8s ease-in-out infinite;
  }
  @keyframes cue-drop {
    0% { transform: translateY(-100%); }
    60%, 100% { transform: translateY(100%); }
  }

  @media (max-width: 640px) {
    .scroll-cue { display: none; }
    .hero { align-items: flex-end; padding-bottom: var(--space-md); }
  }
</style>

<script>
  import { gsap, withGsapContext } from '../../scripts/gsap/core';

  function initHero() {
    const section = document.querySelector('[data-section="hero"]');
    if (!section) return;

    withGsapContext(section, () => {
      const chars = section.querySelectorAll('.hero-model .ch');
      gsap.set(chars, { yPercent: 120, opacity: 0 });
      gsap.to(chars, {
        yPercent: 0,
        opacity: 1,
        duration: 1,
        ease: 'power4.out',
        stagger: 0.06,
        delay: 0.2,
      });

      // Subtle scroll parallax on the media layer — GPU-friendly transform only.
      const media = section.querySelector('.hero-media');
      if (media && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        gsap.to(media, {
          yPercent: 18,
          ease: 'none',
          scrollTrigger: {
            trigger: section,
            start: 'top top',
            end: 'bottom top',
            scrub: true,
          },
        });
      }
    });

    const video = document.getElementById('hero-video') as HTMLVideoElement | null;
    if (video) {
      const reveal = () => video.classList.add('is-playing');
      if (video.readyState >= 2) reveal();
      else video.addEventListener('loadeddata', reveal, { once: true });
      video.play().catch(() => {});
    }
  }

  document.addEventListener('astro:page-load', initHero);
</script>
