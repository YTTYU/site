---
import { Image } from 'astro:assets';
import img from '../../assets/images/advantage/block2-background23.png';
import { advantage } from '../../content/data/copy';
---

<section class="advantage section-light" id="advantage" data-section="advantage">
  <div class="wordmark" aria-hidden="true">P-4</div>

  <div class="media" data-reveal>
    <Image
      src={img}
      alt="P-4 на пересечённой местности"
      widths={[640, 960, 1440, 1920, 2400]}
      sizes="100vw"
      quality={90}
      loading="lazy"
      class="photo"
    />
  </div>

  <div class="container copy-wrap">
    <div class="copy">
      <p class="kicker" data-reveal>{advantage.kicker}</p>
      <h2 class="h2" data-reveal>{advantage.title}</h2>
      {advantage.body.map((p) => <p class="lead" data-reveal>{p}</p>)}
    </div>
  </div>
</section>

<style>
  .advantage {
    position: relative;
    overflow: clip;
    background: var(--c-surface-on-light);
    padding-block: 0;
    display: grid;
    grid-template-rows: minmax(480px, auto);
  }
  .wordmark {
    position: absolute;
    top: 0.4em;
    right: 0;
    font-family: var(--font-display);
    font-size: clamp(6rem, 18vw, 16rem);
    color: transparent;
    -webkit-text-stroke: 1px var(--c-line);
    line-height: 1;
    pointer-events: none;
    z-index: 1;
    user-select: none;
  }

  .media {
    grid-area: 1 / 1;
    position: relative;
    z-index: 0;
    width: 100%;
    height: 116%;
    min-height: 0;
    align-self: center;
    will-change: transform;
  }
  .photo { width: 100%; height: 100%; object-fit: cover; object-position: 0% 50%; display: block; }

  .copy-wrap {
    grid-area: 1 / 1;
    z-index: 2;
    display: flex;
    align-items: center;
    padding-block: var(--space-lg);
  }
  .copy { margin-left: auto; max-width: 44ch; }

  .h2 {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: var(--fs-h2);
    margin-block: 0.5em 0.7em;
    color: var(--c-light);
  }
  .lead {
    color: var(--c-text-dim);
    max-width: 56ch;
    margin-bottom: 1em;
  }

  @media (max-width: 900px) {
    .advantage { display: flex; flex-direction: column; grid-template-rows: none; }
    .media { position: relative; width: 100%; height: auto; aspect-ratio: 1 / 1; }
    .photo { object-position: 0% 35%; }
    .copy-wrap { padding-block: var(--space-lg); }
    .copy { margin-left: 0; max-width: none; }
    .wordmark { display: none; }
  }
</style>

<script>
  import { gsap, withGsapContext } from '../../scripts/gsap/core';

  function initAdvantage() {
    const section = document.querySelector('[data-section="advantage"]');
    if (!section || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    withGsapContext(section, () => {
      const media = section.querySelector('.media');
      if (media) {
        gsap.fromTo(
          media,
          { yPercent: 4, scale: 1.06 },
          {
            yPercent: -4,
            scale: 1,
            ease: 'none',
            scrollTrigger: { trigger: section, start: 'top bottom', end: 'bottom top', scrub: true },
          }
        );
      }
      const wordmark = section.querySelector('.wordmark');
      if (wordmark) {
        gsap.fromTo(
          wordmark,
          { xPercent: 6 },
          {
            xPercent: -4,
            ease: 'none',
            scrollTrigger: { trigger: section, start: 'top bottom', end: 'bottom top', scrub: true },
          }
        );
      }
    });
  }

  document.addEventListener('astro:page-load', initAdvantage);
</script>
