    line-height: 1.35;
  }
  #eng-tracks .tag {
    margin: 0 0.7rem;
    padding: 0 0.7rem 0.75rem;
    border: none;
    background: #fff;
    color: #73777c;
    font-family: var(--font-body);
    font-size: 0.65rem;
    line-height: 1.35;
  }
  #eng-tracks .tread-detail { width: calc(100% - 1.4rem); height: 116px; margin: 0.55rem 0.7rem 0; border: none; }
  #eng-tracks .advantages-media img { border: none; }

  /* The large track image is a section background, not a separate left column. */
  #eng-tracks {
    position: relative;
    min-height: 720px;
    isolation: isolate;
    overflow: hidden;
  }
  #eng-tracks > .media-hero {
    position: absolute;
    z-index: 1;
    inset: 104px 0 auto;
    width: auto;
    height: 660px;
    min-height: 0;
    margin: 0;
    background: transparent;
    align-self: auto;
  }
  #eng-tracks .media-hero-img { object-fit: cover; object-position: left bottom; }
  #eng-tracks > .h3,
  #eng-tracks > .tread-row,
  #eng-tracks > .advantages-row { position: relative; z-index: 2; }
  #eng-tracks > .h3 { background: rgba(243, 242, 239, 0.82); }
  #eng-tracks > .tread-row { background: transparent; }
  #eng-tracks .tread-col { background: rgba(255, 255, 255, 0.72); }
  #eng-tracks .tread-pill,
  #eng-tracks .body-p,
  #eng-tracks .tag { background: rgba(255, 255, 255, 0.78); }
  #eng-tracks .media-hero-content {
    z-index: 2;
    top: 46px;
    right: auto;
    left: 14%;
    width: min(42%, 420px);
    background: rgba(130, 130, 130, 0.83);
  }

  /* Icon strip / icon bullet list — shared across amphibious, cargo, equipment, maintenance */
  .icon { width: 22px; height: 22px; flex: none; color: var(--c-accent-ink); }
  .stat-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    border: 1px solid var(--c-line);
    background: var(--c-bg-panel);
    margin-bottom: var(--space-lg);
  }
  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5em;
    padding: var(--space-md);
    border-right: 1px solid var(--c-line);
  }
  .stat-item:last-child { border-right: none; }
  .stat-value { font-family: var(--font-heading); font-weight: 900; font-size: 1.2rem; color: var(--c-light); }
  .stat-label { font-size: 0.8rem; color: var(--c-text-dim); }

  .icon-bullets { display: flex; flex-direction: column; gap: 1em; margin-top: 1em; }
  .icon-bullet { display: flex; gap: 0.9em; align-items: flex-start; padding-bottom: 1em; border-bottom: 1px solid var(--c-line); }
  .icon-bullet:last-child { border-bottom: none; padding-bottom: 0; }
  .icon-bullet p { color: var(--c-text-dim); font-size: 0.92rem; margin: 0; }
  .icon-bullet strong { color: var(--c-text); }

  .caption-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); margin-bottom: var(--space-lg); }
  .caption-grid img { width: 100%; height: 220px; object-fit: cover; border: 1px solid var(--c-line); }
  .caption-grid img.crop-tight { object-position: 70% 30%; }
  .caption-grid figcaption { display: flex; flex-direction: column; gap: 0.3em; margin-top: 0.6em; }
  .caption-grid figcaption strong { color: var(--c-text); font-family: var(--font-heading); }
  .caption-grid figcaption span { color: var(--c-text-dim); font-size: 0.88rem; }

  .attach-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-md); margin-bottom: var(--space-lg); }
  .attach-card { border: 1px solid var(--c-line); overflow: hidden; background: var(--c-bg-panel); }
  .attach-card img { width: 100%; aspect-ratio: 4/3; object-fit: contain; background: var(--c-surface); transition: transform var(--dur-med) var(--ease-out); border: none; }
  .attach-card:hover img { transform: scale(1.06); }
  .attach-card figcaption { padding: 0.8em 1em; font-size: var(--fs-small); color: var(--c-text-dim); border-top: 1px solid var(--c-line); }

  /* Tight hover-zoom gallery (block 8) */
  .tight-gallery { display: grid; grid-template-columns: repeat(5, 1fr); gap: 2px; margin-bottom: var(--space-lg); }
  .tight-gallery-item { position: relative; aspect-ratio: 1; overflow: hidden; cursor: zoom-in; }
  .tight-gallery-item img { width: 100%; height: 100%; object-fit: cover; border: none; transition: transform var(--dur-med) var(--ease-out); }
  .tight-gallery-item:hover img { transform: scale(1.18); }

  .eng-lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-lg);
    background: rgba(6, 7, 8, 0.94);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--dur-med) var(--ease-out);
  }
  .eng-lightbox.is-open { opacity: 1; visibility: visible; }
  .eng-lightbox-img {
    max-width: 90vw;
    max-height: 90vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border: 1px solid var(--c-line-dark);
    transform: scale(0.96);
    transition: transform var(--dur-med) var(--ease-out);
  }
  .eng-lightbox.is-open .eng-lightbox-img { transform: scale(1); }
  .eng-lightbox-close {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--c-text-dark);
    border: 1px solid var(--c-line-dark);
    background: rgba(10, 11, 13, 0.6);
    transition: border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .eng-lightbox-close:hover { border-color: var(--c-accent); color: var(--c-accent); }
  .eng-lightbox-close svg { width: 20px; height: 20px; }

  @media (max-width: 980px) {
    .eng-grid { grid-template-columns: 1fr; }
    .eng-tabs {
      position: static;
      max-height: none;
      overflow-y: visible;
      border-right: none;
      border-bottom: 1px solid var(--c-line);
      padding-bottom: var(--space-sm);
      padding-right: 0;
      margin-bottom: var(--space-md);
    }
    .eng-tabs ul { flex-direction: row; flex-wrap: wrap; gap: 0.2rem 0.6rem; }
    .eng-tab { width: auto; padding: 0.5em 0.3em; }
    .eng-tab:hover, .eng-tab.is-active { padding-left: 0.3em; }
    .eng-ticker-item { font-size: 1.05rem; padding: 0.4em 0.9em; }
    .two-col, .two-col.reverse { grid-template-columns: 1fr; }
    .attach-cards { grid-template-columns: 1fr 1fr; }
    .tread-row, .advantages-row, .caption-grid { grid-template-columns: 1fr; }
    #eng-tracks.is-active { display: block; }
    #eng-tracks > .h3 { min-height: 0; padding: 1.5rem; margin: 0; }
    #eng-tracks > .media-hero { position: relative; inset: auto; height: 420px; min-height: 0; margin-bottom: var(--space-md); }
    #eng-tracks > .tread-row { grid-template-columns: 1fr 1fr; padding: 0 0.75rem 0.75rem; margin: 0; }
    .photo-grid { grid-template-columns: repeat(2, 1fr); }
    .tight-gallery { grid-template-columns: repeat(4, 1fr); }
  }
  @media (max-width: 560px) {
    .attach-cards { grid-template-columns: 1fr; }
    .dash-list.two-cols { grid-template-columns: 1fr; }
    .tight-gallery { grid-template-columns: repeat(3, 1fr); }
  }
</style>

<script>
  import { reveal } from '../../scripts/gsap/core';

  function initEngineering() {
    const section = document.querySelector('[data-section="engineering"]');
    if (!section) return;
    if ((section as HTMLElement).dataset.engInit === 'true') return;
    (section as HTMLElement).dataset.engInit = 'true';

    // Tab switcher
    const tabs = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-eng-tab]'));
    const blocks = Array.from(section.querySelectorAll<HTMLElement>('[data-eng-block]'));
    const readoutIndex = document.getElementById('eng-readout-index');
    const readoutLabel = document.getElementById('eng-readout-label');
    const contentTop = section.querySelector<HTMLElement>('.eng-content');
    const revealed = new Set<HTMLElement>();

    function activate(id: string, scrollIntoView = false) {
      const tabIdx = tabs.findIndex((t) => t.dataset.engTab === id);
      if (tabIdx === -1) return;

      tabs.forEach((t) => {
        const match = t.dataset.engTab === id;
        t.classList.toggle('is-active', match);
        t.setAttribute('aria-selected', String(match));
      });

      blocks.forEach((b) => {
        const match = b.dataset.engBlock === id;
        if (match) {
          b.classList.add('is-active');
          b.classList.remove('is-visible');
          void b.offsetWidth;
          requestAnimationFrame(() => b.classList.add('is-visible'));
          // [data-reveal] children never intersect while display:none, so their
          // ScrollTrigger.batch never fires — (re)register once the block is shown.
          if (!revealed.has(b)) {
            revealed.add(b);
            reveal(b);
          }
        } else {
          b.classList.remove('is-active', 'is-visible');
        }
      });

      if (readoutIndex) readoutIndex.textContent = String(tabIdx + 1).padStart(2, '0');
      if (readoutLabel) readoutLabel.textContent = tabs[tabIdx].dataset.engLabel ?? '';

      if (scrollIntoView && contentTop && window.innerWidth < 980) {
        contentTop.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    tabs.forEach((t) => t.addEventListener('click', () => activate(t.dataset.engTab ?? '', true)));

    if (blocks.length) activate(blocks[0].dataset.engBlock ?? '');

    // Ergonomics gallery lightbox
    const lightbox = document.getElementById('eng-lightbox');
    const lightboxImg = document.getElementById('eng-lightbox-img') as HTMLImageElement | null;
    if (lightbox && lightboxImg) {
      const open = (img: HTMLImageElement) => {
        lightboxImg.src = img.currentSrc || img.src;
        lightboxImg.alt = img.alt;
        lightbox.classList.add('is-open');
        lightbox.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      };
      const close = () => {
        lightbox.classList.remove('is-open');
        lightbox.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      };

      section.querySelectorAll<HTMLImageElement>('.tight-gallery-item img').forEach((img) => {
        img.addEventListener('click', () => open(img));
      });
      lightbox.querySelector('[data-eng-lightbox-close]')?.addEventListener('click', close);
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) close();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && lightbox.classList.contains('is-open')) close();
      });
    }
  }

  document.addEventListener('astro:page-load', initEngineering);
</script>
