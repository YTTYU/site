---
import { Image } from 'astro:assets';
import { gallerySection } from '../../content/data/copy';

const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/gallery/*', { eager: true });
const items = Object.entries(images)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => ({ src: mod.default, alt: path.split('/').pop() ?? 'Jagger Garage' }));
---

<section class="gallery" id="gallery" data-section="gallery">
  <div class="story-stage" id="story-stage" data-reveal>
    <div class="story-bg" aria-hidden="true">
      <img class="story-bg-img story-bg-prev" id="story-bg-prev" alt="" />
      <img class="story-bg-img story-bg-next" id="story-bg-next" alt="" />
    </div>

    <button type="button" class="story-arrow story-arrow-prev" data-story-prev aria-label="Предыдущее фото">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
    </button>

    <div class="story-card">
      <div class="story-photos">
        {items.map((it, i) => (
          <Image
            src={it.src}
            alt="Jagger Garage P-4 — производство и эксплуатация"
            widths={[480, 720, 1080]}
            sizes="(max-width: 700px) 90vw, 560px"
            loading={i === 0 ? 'eager' : 'lazy'}
            class="story-photo"
            data-story-photo
            data-index={i}
          />
        ))}
        <div class="story-photo-overlay"></div>
      </div>

      <div class="story-copy">
        <p class="story-kicker">{gallerySection.kicker}</p>
        <h2 class="story-title">{gallerySection.title}</h2>
        <div class="story-dots" role="tablist" aria-label="Фотографии">
          {items.map((_, i) => (
            <span class="story-dot" data-story-dot data-index={i}><span class="story-dot-fill"></span></span>
          ))}
        </div>
      </div>
    </div>

    <button type="button" class="story-arrow story-arrow-next" data-story-next aria-label="Следующее фото">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6" /></svg>
    </button>
  </div>

  <div class="lightbox" id="gallery-lightbox" aria-hidden="true">
    <button type="button" class="lightbox-close" data-lightbox-close aria-label="Закрыть">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
    <img src="" alt="" class="lightbox-img" id="lightbox-img" />
  </div>
</section>

<style>
  .gallery { padding-block: 0; }
  .story-stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100svh;
    overflow: hidden;
    background: #000;
  }

  .story-bg { position: absolute; inset: 0; z-index: 0; }
  .story-bg-img {
    position: absolute;
    top: 50%;
    width: 44%;
    height: 130%;
    object-fit: cover;
    transform: translateY(-50%) scale(1.15);
    filter: grayscale(1) brightness(0.32) blur(6px);
    transition: opacity 1.1s var(--ease-out);
    opacity: 0;
  }
  .story-bg-img.is-visible { opacity: 1; }
  .story-bg-prev { left: 0; }
  .story-bg-next { right: 0; }
  .story-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 58% 75% at center, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.25) 48%, transparent 68%),
      linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.65));
  }

  .story-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.65);
    transition: color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .story-arrow-prev { left: clamp(0.75rem, 3vw, 3rem); }
  .story-arrow-next { right: clamp(0.75rem, 3vw, 3rem); }
  .story-arrow svg { width: 32px; height: 32px; }
  .story-arrow:hover { color: #fff; }
  .story-arrow-prev:hover { transform: translateY(-50%) translateX(-3px); }
  .story-arrow-next:hover { transform: translateY(-50%) translateX(3px); }

  .story-card {
    position: relative;
    z-index: 1;
    width: min(90vw, 520px);
    display: flex;
    flex-direction: column;
    box-shadow: 0 40px 100px -20px rgba(0, 0, 0, 0.85);
  }

  .story-photos {
    position: relative;
    flex: 0 0 auto;
    height: min(58svh, 460px);
    overflow: hidden;
    cursor: zoom-in;
  }
  .story-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.1s var(--ease-out), transform 6s linear;
    transform: scale(1.02);
  }
  .story-photo.active { opacity: 1; transform: scale(1.08); }
  .story-photo-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.35) 42%, rgba(0,0,0,0.05) 65%, transparent 100%);
  }

  .story-copy {
    position: relative;
    flex-shrink: 0;
    margin-top: -1px;
    padding: 0.5em 2em 1.4em;
    text-align: center;
    background: #000;
  }
  .story-kicker {
    font-family: var(--font-label);
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c-accent);
    margin-bottom: 0.5em;
  }
  .story-title {
    font-family: var(--font-slab);
    font-style: italic;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--c-light);
    margin-bottom: 0.9em;
  }

  .story-dots { display: flex; align-items: center; justify-content: center; gap: 0.5em; }
  .story-dot {
    position: relative;
    width: 20px;
    height: 3px;
    background: var(--c-line);
    cursor: pointer;
    overflow: hidden;
  }
  .story-dot-fill {
    position: absolute;
    inset: 0;
    width: 0%;
    background: var(--c-accent);
    transform-origin: left;
  }
  .story-dot.active .story-dot-fill { animation: story-fill linear forwards; animation-duration: var(--story-duration, 5s); }
  @keyframes story-fill {
    from { width: 0%; }
    to { width: 100%; }
  }

  @media (max-width: 860px) {
    .story-bg-img { display: none; }
    .story-arrow { width: 36px; height: 36px; }
    .story-arrow svg { width: 24px; height: 24px; }
    .story-arrow-prev { left: 0.5rem; }
    .story-arrow-next { right: 0.5rem; }
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-lg);
    background: rgba(6, 7, 8, 0.94);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--dur-med) var(--ease-out);
  }
  .lightbox.is-open { opacity: 1; visibility: visible; }
  .lightbox-img {
    max-width: 90vw;
    max-height: 90vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border: 1px solid var(--c-line);
    transform: scale(0.96);
    transition: transform var(--dur-med) var(--ease-out);
  }
  .lightbox.is-open .lightbox-img { transform: scale(1); }
  .lightbox-close {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--c-text);
    border: 1px solid var(--c-line);
    background: rgba(10, 11, 13, 0.6);
    transition: border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .lightbox-close:hover { border-color: var(--c-accent); color: var(--c-accent); }
  .lightbox-close svg { width: 20px; height: 20px; }
</style>

<script>
  function initStoryGallery() {
    const section = document.querySelector('[data-section="gallery"]');
    const stage = document.getElementById('story-stage');
    if (!section || !stage) return;
    if (stage.dataset.storyInit === 'true') return; // guard against duplicate astro:page-load firings
    stage.dataset.storyInit = 'true';

    const photos = Array.from(section.querySelectorAll<HTMLImageElement>('[data-story-photo]'));
    const dots = Array.from(section.querySelectorAll<HTMLElement>('[data-story-dot]'));
    const bgPrev = document.getElementById('story-bg-prev') as HTMLImageElement | null;
    const bgNext = document.getElementById('story-bg-next') as HTMLImageElement | null;
    const prevBtn = section.querySelector<HTMLButtonElement>('[data-story-prev]');
    const nextBtn = section.querySelector<HTMLButtonElement>('[data-story-next]');
    if (!photos.length) return;

    const AUTO_MS = 5000;
    stage.style.setProperty('--story-duration', `${AUTO_MS}ms`);
    let index = 0;
    let timer: ReturnType<typeof setTimeout> | null = null;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const srcOf = (i: number) => {
      const el = photos[(i + photos.length) % photos.length];
      return el.currentSrc || el.src;
    };

    function render() {
      photos.forEach((p, i) => p.classList.toggle('active', i === index));
      dots.forEach((d, i) => d.classList.toggle('active', i === index && !reduced));
      if (bgPrev) { bgPrev.src = srcOf(index - 1); bgPrev.classList.add('is-visible'); }
      if (bgNext) { bgNext.src = srcOf(index + 1); bgNext.classList.add('is-visible'); }
    }

    function goTo(i: number, restart = true) {
      index = (i + photos.length) % photos.length;
      render();
      if (restart) scheduleNext();
    }

    function scheduleNext() {
      if (timer) clearTimeout(timer);
      if (reduced) return;
      timer = setTimeout(() => goTo(index + 1), AUTO_MS);
    }

    prevBtn?.addEventListener('click', () => goTo(index - 1));
    nextBtn?.addEventListener('click', () => goTo(index + 1));
    dots.forEach((d) => d.addEventListener('click', () => goTo(Number(d.dataset.index ?? 0))));

    stage.addEventListener('mouseenter', () => { if (timer) clearTimeout(timer); });
    stage.addEventListener('mouseleave', () => scheduleNext());

    render();
    scheduleNext();

    // Click-to-enlarge, reusing the shared lightbox
    const lightbox = document.getElementById('gallery-lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    if (lightbox && lightboxImg) {
      const open = () => {
        const active = photos[index];
        lightboxImg.src = active.currentSrc || active.src;
        lightboxImg.alt = active.alt;
        lightbox.classList.add('is-open');
        lightbox.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      };
      const close = () => {
        lightbox.classList.remove('is-open');
        lightbox.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      };
      section.querySelector('.story-photos')?.addEventListener('click', open);
      lightbox.querySelector('[data-lightbox-close]')?.addEventListener('click', close);
      lightbox.addEventListener('click', (e) => { if (e.target === lightbox) close(); });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && lightbox.classList.contains('is-open')) close();
      });
    }
  }

  document.addEventListener('astro:page-load', initStoryGallery);
</script>
