---
import { Image } from 'astro:assets';
import { gallerySection, trust } from '../../content/data/copy';

const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/gallery/*', { eager: true });
const items = Object.entries(images)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => ({ src: mod.default, alt: path.split('/').pop() ?? 'Jagger Garage' }));

import certImg from '../../assets/images/trust/record-certificate.png';
---

<section class="gallery" id="gallery" data-section="gallery">
  <div class="container gallery-head">
    <p class="kicker" data-reveal>{gallerySection.kicker}</p>
    <h2 class="h2" data-reveal>{gallerySection.title}</h2>
  </div>

  <div class="rail-viewport" id="rail-viewport">
    <div class="rail" id="rail">
      {items.map((it) => (
        <figure class="rail-item">
          <Image src={it.src} alt="Jagger Garage P-4 — производство и эксплуатация" widths={[480, 720]} sizes="60vw" loading="lazy" />
        </figure>
      ))}
    </div>
  </div>

  <div class="container">
    <div class="trust-card" data-reveal>
      <Image src={certImg} alt="Сертификат Книги рекордов России" widths={[240, 360, 480]} sizes="220px" loading="lazy" class="trust-img" />
      <div class="trust-copy">
        <p class="kicker">{trust.title}</p>
        <p class="trust-result">{trust.result}</p>
        <p class="trust-body">{trust.body}</p>
        <p class="trust-meta">{trust.holder} — {trust.place}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .gallery-head { margin-bottom: var(--space-lg); }
  .h2 { font-family: var(--font-heading); font-weight: 900; font-size: var(--fs-h2); color: var(--c-light); margin-top: 0.3em; }

  .rail-viewport {
    overflow: hidden;
    margin-bottom: var(--space-section);
  }
  .rail {
    display: flex;
    gap: 1rem;
    padding-inline: var(--content-pad);
    will-change: transform;
  }
  .rail-item {
    flex: none;
    width: min(70vw, 480px);
    aspect-ratio: 4/3;
    border: 1px solid var(--c-line);
    overflow: hidden;
  }
  .rail-item :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .trust-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-lg);
    align-items: center;
    border: 1px solid var(--c-line);
    background: var(--c-bg-panel);
    padding: var(--space-lg);
  }
  .trust-img { width: 160px; height: auto; border: 1px solid var(--c-line); }
  .trust-result { font-family: var(--font-display); font-size: 2.5rem; color: var(--c-accent); margin-block: 0.2em; }
  .trust-body { color: var(--c-text-dim); max-width: 60ch; margin-bottom: 0.6em; }
  .trust-meta { font-size: var(--fs-small); color: var(--c-text-faint); }

  @media (max-width: 640px) {
    .trust-card { grid-template-columns: 1fr; text-align: left; }
    .trust-img { width: 120px; }
  }

  @media (max-width: 720px) {
    .rail-viewport { overflow-x: auto; -webkit-overflow-scrolling: touch; scroll-snap-type: x proximity; }
    .rail-item { scroll-snap-align: start; }
  }
</style>

<script>
  import { gsap, withGsapContext } from '../../scripts/gsap/core';

  function initGalleryRail() {
    const section = document.querySelector('[data-section="gallery"]');
    const viewport = document.getElementById('rail-viewport');
    const rail = document.getElementById('rail');
    if (!section || !viewport || !rail) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.matchMedia('(max-width: 720px)').matches) return; // native swipe scroll on touch/small screens

    withGsapContext(section, () => {
      const distance = () => Math.max(0, rail.scrollWidth - viewport.clientWidth);
      const tween = gsap.to(rail, {
        x: () => -distance(),
        ease: 'none',
        scrollTrigger: {
          trigger: viewport,
          start: 'top 20%',
          end: () => `+=${distance()}`,
          scrub: true,
          pin: false,
          invalidateOnRefresh: true,
        },
      });
      return () => tween.kill();
    });
  }

  document.addEventListener('astro:page-load', initGalleryRail);
</script>
