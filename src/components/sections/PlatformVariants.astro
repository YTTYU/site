---
import { Image } from 'astro:assets';
import single from '../../assets/images/platform/single-cab.png';
import double from '../../assets/images/platform/double-cab.png';
import box from '../../assets/images/platform/box-cab.png';
import { platformVariants } from '../../content/data/copy';

const images = { single, double, box } as const;
---

<section class="platform" id="platform" data-section="platform">
  <div class="container">
    <h2 class="h2" data-reveal>{platformVariants.title}</h2>

    <div class="config" data-reveal>
      <div class="segmented" role="radiogroup" aria-label="Варианты исполнения">
        {platformVariants.variants.map((v, i) => (
          <label class="segment">
            <input type="radio" name="variant" value={v.key} checked={i === 0} />
            <span>{v.desc}</span>
          </label>
        ))}
      </div>

      <div class="stage">
        {platformVariants.variants.map((v, i) => (
          <Image
            src={images[v.key as keyof typeof images]}
            alt={v.desc}
            widths={[480, 720, 1080, 1440]}
            sizes="(max-width: 900px) 100vw, 70vw"
            quality={85}
            loading="lazy"
            class="stage-img"
            data-variant={v.key}
            style={i === 0 ? '' : 'opacity:0; visibility:hidden;'}
          />
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .h2 {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: var(--fs-h2);
    color: var(--c-light);
    margin-bottom: var(--space-lg);
  }
  .segmented {
    display: inline-flex;
    border: 1px solid var(--c-line);
    margin-bottom: var(--space-md);
  }
  .segment {
    position: relative;
    padding: 0.7em 1.4em;
    font-family: var(--font-label);
    font-size: var(--fs-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-text-dim);
    cursor: pointer;
    border-right: 1px solid var(--c-line);
  }
  .segment:last-child { border-right: none; }
  .segment input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .segment:has(input:checked) {
    color: var(--c-bg);
    background: var(--c-accent);
  }
  .segment:has(input:focus-visible) { outline: 2px solid var(--c-accent); outline-offset: 2px; }

  .stage {
    position: relative;
    border: 1px solid var(--c-line);
    background: var(--c-bg-panel);
    min-height: 280px;
  }
  .stage-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity 0.5s var(--ease-out);
  }
  .stage-img:first-child { position: relative; }
</style>

<script>
  function initPlatformSwitcher() {
    const section = document.querySelector('[data-section="platform"]');
    if (!section) return;
    const inputs = section.querySelectorAll<HTMLInputElement>('input[name="variant"]');
    const images = section.querySelectorAll<HTMLImageElement>('.stage-img');

    inputs.forEach((input) => {
      input.addEventListener('change', () => {
        images.forEach((img) => {
          const match = img.dataset.variant === input.value;
          img.style.opacity = match ? '1' : '0';
          img.style.visibility = match ? 'visible' : 'hidden';
        });
      });
    });
  }

  document.addEventListener('astro:page-load', initPlatformSwitcher);
</script>
