---
import { positioning } from '../../content/data/copy';

const categoryIcons = ['/images/vehicle-steel-track.svg', '/images/vehicle-dump-truck.svg', '/images/vehicle-compact.svg'];
---

<section class="positioning section-light" id="positioning" data-section="positioning">
  <div class="container">
    <div class="intro-panel" data-reveal>
      <h2 class="h2">{positioning.jagger.subtitle}</h2>
      <p class="lead">{positioning.intro}</p>
    </div>

    <div class="cards">
      {positioning.categories.map((cat, i) => (
        <div class="card" data-reveal>
          <div class="card-visual">
            <h3>{cat.title}</h3>
            <img src={categoryIcons[i]} alt="" class="card-illustration" aria-hidden="true" />
          </div>
          <ul>
            {cat.bullets.map((b) => <li>{b}</li>)}
          </ul>
        </div>
      ))}
    </div>

    <div class="jagger-panel" data-reveal>
      <div class="jagger-visual">
        <h3>{positioning.jagger.title}</h3>
        <img src="/images/vehicle-jagger.svg" alt="" class="jagger-illustration" aria-hidden="true" />
      </div>
      <ul class="jagger-bullets">
        {positioning.jagger.bullets.map((b) => <li>{b}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .intro-panel {
    background: rgba(221, 221, 221, 0.62);
    padding: var(--space-lg);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    align-items: start;
    margin-bottom: var(--space-md);
  }
  .h2 {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: var(--fs-h2);
    color: var(--c-light);
    max-width: 20ch;
    margin: 0;
  }
  .intro-panel .lead {
    font-family: var(--font-slab);
    font-style: italic;
    color: var(--c-text-dim);
    max-width: 56ch;
    margin: 0;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .card-visual {
    position: relative;
    min-height: 210px;
    overflow: visible;
    padding: var(--space-md);
    margin-bottom: 56px;
    background: rgba(221, 221, 221, 0.62);
  }
  .card h3 {
    position: relative;
    z-index: 1;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--c-light);
    min-height: 2.6em;
    margin-bottom: 0.8em;
  }
  .card-illustration {
    position: absolute;
    z-index: 0;
    width: 90%;
    height: 72%;
    right: 3%;
    bottom: -46px;
    object-fit: contain;
    object-position: center bottom;
    opacity: 0.82;
    filter: brightness(0.76) contrast(1.08);
  }
  .card ul {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.6em;
    flex: 1;
    min-height: 126px;
    margin: 0;
    padding: 1rem var(--space-md);
    background: rgba(243, 242, 239, 0.82);
  }
  .card li { font-size: var(--fs-small); color: var(--c-text-dim); padding-left: 1.1em; position: relative; }
  .card li::before { content: '•'; position: absolute; left: 0; color: var(--c-text-faint); }

  .jagger-panel {
    background: transparent;
    padding: 0;
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: var(--space-lg);
    align-items: center;
  }
  .jagger-visual h3 {
    position: relative;
    z-index: 1;
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 1.3rem;
    color: var(--c-light);
    max-width: 16ch;
    margin-bottom: 1em;
  }
  .jagger-visual {
    position: relative;
    min-height: 330px;
    padding: var(--space-lg);
    overflow: visible;
    margin-bottom: 52px;
    background: rgba(221, 221, 221, 0.62);
  }
  .jagger-illustration {
    position: absolute;
    z-index: 0;
    width: min(104%, 400px);
    max-width: none;
    height: auto;
    left: 0;
    bottom: -52px;
    opacity: 0.82;
    filter: brightness(0.76) contrast(1.08);
  }
  .jagger-bullets {
    display: flex;
    flex-direction: column;
    align-self: stretch;
    justify-content: center;
    gap: 0.9em;
    padding: var(--space-lg);
    background: rgba(221, 221, 221, 0.62);
  }
  .jagger-bullets li { font-size: 0.95rem; color: var(--c-text); padding-left: 1.2em; position: relative; }
  .jagger-bullets li::before { content: '•'; position: absolute; left: 0; color: var(--c-text-faint); }

  @media (max-width: 1100px) {
    .cards { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 720px) {
    .intro-panel, .jagger-panel { grid-template-columns: 1fr; }
    .cards { grid-template-columns: 1fr; }
    .jagger-illustration { max-width: 220px; }
  }
</style>
