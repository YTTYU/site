---
import { platformIntro } from '../../content/data/copy';
---

<section class="platform-intro section-alt" data-section="platform-intro">
  <div class="container grid">
    <div>
      <p class="kicker" data-reveal>{platformIntro.kicker}</p>
      <h2 class="h2" data-reveal>{platformIntro.title}</h2>
    </div>
    <div>
      {platformIntro.body.map((p) => <p class="lead" data-reveal>{p}</p>)}
      <p class="note" data-reveal>{platformIntro.note}</p>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 5vw, 5rem);
  }
  .h2 {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: var(--fs-h2);
    color: var(--c-light);
    margin-top: 0.5em;
  }
  .lead { color: var(--c-text-dim); max-width: 60ch; margin-bottom: 1em; }
  .note {
    border-left: 2px solid var(--c-accent);
    padding-left: 1em;
    font-family: var(--font-label);
    font-size: 0.9rem;
    color: var(--c-text);
    max-width: 50ch;
  }
  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
