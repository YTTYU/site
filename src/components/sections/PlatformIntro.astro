---
import { Image } from 'astro:assets';
import single from '../../assets/images/platform/single-cab-final.png';
import double from '../../assets/images/platform/double-cab-final.png';
import box from '../../assets/images/platform/passenger-final.png';
import { platformIntro, platformVariants } from '../../content/data/copy';

const images = { single, double, box } as const;
---

<section class="platform-intro section-alt" id="platform" data-section="platform-intro">
  <div class="container">
    <div class="intro-grid">
      <div>
        <p class="kicker" data-reveal>{platformIntro.kicker}</p>
        <h2 class="h2" data-reveal>{platformIntro.title}</h2>
      </div>
      <div>
        {platformIntro.body.map((p) => <p class="lead" data-reveal>{p}</p>)}
        <p class="note" data-reveal>{platformIntro.note}</p>
      </div>
    </div>

    <div class="variants" data-reveal>
      <div class="variant-list" role="radiogroup" aria-label="Варианты исполнения">
        {platformVariants.variants.map((v, i) => (
          <label class="variant-option">
            <input type="radio" name="variant" value={v.key} checked={i === 0} />
            <span>{v.desc}</span>
          </label>
        ))}
      </div>

      <div class="stage">
        {platformVariants.variants.map((v, i) => (
          <Image
            src={images[v.key as keyof typeof images]}
            alt={v.desc}
            widths={[480, 720, 1080, 1440]}
            sizes="(max-width: 900px) 100vw, 68vw"
            quality={85}
            loading="lazy"
            class="stage-img"
            data-variant={v.key}
            style={i === 0 ? '' : 'opacity:0; visibility:hidden;'}
          />
        ))}
        <img
          src="/images/dims-overlay.svg"
          alt=""
          class="stage-dims"
          data-dims-overlay
          aria-hidden="true"
        />
        <button type="button" class="dims-toggle" data-dims-toggle aria-pressed="false">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M4 16h16M4 16v-4M8 16v-3M12 16v-4M16 16v-3M20 16v-4" />
          </svg>
          <span>Размеры</span>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .intro-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 5vw, 5rem);
    margin-bottom: var(--space-lg);
  }
  .h2 {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: var(--fs-h2);
    color: var(--c-light);
    margin-top: 0.5em;
  }
  .lead { color: var(--c-text-dim); max-width: 60ch; margin-bottom: 1em; }
  .note {
    border-left: 2px solid var(--c-accent);
    padding-left: 1em;
    font-family: var(--font-label);
    font-size: 0.9rem;
    color: var(--c-text);
    max-width: 50ch;
  }

  .variants {
    display: grid;
    grid-template-columns: 0.32fr 0.68fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }

  .variant-list { display: flex; flex-direction: column; gap: 1.4rem; }
  .variant-option { cursor: pointer; width: fit-content; }
  .variant-option input { position: absolute; opacity: 0; pointer-events: none; }
  .variant-option span {
    display: block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(1.05rem, 1.6vw, 1.35rem);
    color: var(--c-text-dim);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .variant-option:hover span { color: var(--c-text); }
  .variant-option:has(input:checked) span { color: var(--c-light); }
  .variant-option:has(input:focus-visible) span { outline: 2px solid var(--c-accent); outline-offset: 4px; }

  .stage {
    position: relative;
    border: 1px solid var(--c-line);
    background-color: var(--c-bg-panel);
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 32px 32px;
    aspect-ratio: 2121 / 1413;
    overflow: hidden;
  }
  .stage-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity 0.5s var(--ease-out);
  }
  .stage-dims {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s var(--ease-out);
  }

  .dims-toggle {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.5em 0.9em;
    background: rgba(10, 11, 13, 0.72);
    border: 1px solid var(--c-line);
    color: var(--c-text-dim);
    font-family: var(--font-label);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    backdrop-filter: blur(4px);
    transition: border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .dims-toggle:hover { color: var(--c-text); }
  .dims-toggle[aria-pressed="true"] { border-color: var(--c-accent); color: var(--c-accent); }

  @media (max-width: 900px) {
    .intro-grid { grid-template-columns: 1fr; }
    .variants { grid-template-columns: 1fr; }
    .variant-list { flex-direction: row; flex-wrap: wrap; gap: 0.8rem 1.6rem; }
  }
</style>

<script>
  function initPlatformSwitcher() {
    const section = document.querySelector('[data-section="platform-intro"]');
    if (!section) return;

    const inputs = section.querySelectorAll<HTMLInputElement>('input[name="variant"]');
    const images = section.querySelectorAll<HTMLImageElement>('.stage-img');

    inputs.forEach((input) => {
      input.addEventListener('change', () => {
        images.forEach((img) => {
          const match = img.dataset.variant === input.value;
          img.style.opacity = match ? '1' : '0';
          img.style.visibility = match ? 'visible' : 'hidden';
        });
      });
    });

    const dimsToggle = section.querySelector<HTMLButtonElement>('[data-dims-toggle]');
    const dimsOverlay = section.querySelector<HTMLElement>('[data-dims-overlay]');
    if (dimsToggle && dimsOverlay) {
      dimsToggle.addEventListener('click', () => {
        const isActive = dimsToggle.getAttribute('aria-pressed') === 'true';
        dimsToggle.setAttribute('aria-pressed', String(!isActive));
        dimsOverlay.style.opacity = isActive ? '0' : '1';
      });
    }
  }

  document.addEventListener('astro:page-load', initPlatformSwitcher);
</script>
